APPNAME=zonse247-pos
AUTO_SYNC_ENABLED=false
APPLICATION_ENVIRONMENT=web

APP_NAME=Zonse247 POS
APP_DESCRIPTION=Point of Sale System for Zonse247
APP_AUTHOR=Zonse247 Team
APP_VERSION=1.0.0
APP_WEBSITE=https://pos.zonse247.com
APP_USERS=users
APP_LICENSE=MIT
APP_CONTACT=+265991593543
APP_COPYRIGHT=© 2023 Zonse247 Team

# client config
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_TITLE=Zonse247 POS
VITE_DEBUG_MODE=true

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost
TRUST_PROXY=true
SERVER_TIMEOUT=30000

# Database Configuration
DB_SEED=false
SYNC_INTERVAL=300000
DB_NAME=
DB_MIGRATE=false
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://pos.vitalitymw.com,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
ACCOUNT_CREATION_LIMIT=5

# Logging
LOG_LEVEL=info
ENABLE_ANALYTICS=true
LOG_FILE_PATH=./logs/app.log

# Email Configuration (for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=zonse247@gmail.com
SMTP_PASS=
SMTP_FROM="Zonse247 POS <zonse247@gmail.com>"

# Redis Configuration (for sessions/caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./.backups/uploads
MIGRATIONS_PATH=./.backups/migrations
APP_DATA_PATH=./.data/zonse247-pos

# API Configuration
API_VERSION=v1
API_PREFIX=/api
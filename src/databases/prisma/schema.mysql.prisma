// ==========================================
// SERVER-ONLY SYNC TABLES
// These tables exist only on the central MySQL server
// to manage multi-terminal synchronization state
// ==========================================

/// Tracks what each terminal has already synced (server-only)
model TerminalSyncState {
  id            String    @id @default(uuid()) @map("terminal_sync_state_id")
  terminalId    String    @map("terminal_id")
  tenantId      String    @map("tenant_id")
  branchId      String    @map("branch_id")
  
  lastPulledAt  DateTime? @map("last_pulled_at")    // last time terminal pulled from server
  lastPushedAt  DateTime? @map("last_pushed_at")    // last time terminal pushed to server
  lastSequence  BigInt?   @map("last_sequence")     // optional: incremental sequence for change log
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  terminal      Terminal  @relation(fields: [terminalId], references: [terminalId], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch        Branch    @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  
  @@unique([tenantId, branchId, terminalId], name: "unique_terminal_sync")
  @@index([terminalId])
  @@index([tenantId])
  @@index([branchId])
  @@map("terminal_sync_state")
}

/// Change log for efficient delta sync (server-only)
/// Records every data change so terminals can pull only what's new
/// instead of scanning entire tables with updatedAt > lastPulledAt
model ChangeLog {
  id          BigInt              @id @default(autoincrement())
  tableName   String              @map("table_name") @db.VarChar(50)    // e.g., 'sales', 'customers'
  recordId    String              @map("record_id") @db.VarChar(191)    // UUID of the changed row
  operation   ChangeLogOperation  @map("operation")                      // INSERT, UPDATE, DELETE
  tenantId    String              @map("tenant_id") @db.VarChar(191)
  branchId    String              @map("branch_id") @db.VarChar(191)
  version     Int                 @map("version")                        // new version after change
  
  terminalId  String?             @map("terminal_id") @db.VarChar(191)  // terminal that made the change
  userId      String?             @map("user_id") @db.VarChar(191)      // user that made the change
  payload     Json?               @map("payload")                        // optional: changed data snapshot
  
  createdAt   DateTime            @default(now()) @map("created_at")
  
  tenant      Tenant              @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch              @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  
  @@index([tenantId, branchId, createdAt], name: "idx_tenant_branch_time")
  @@index([tenantId, branchId, tableName, createdAt], name: "idx_tenant_branch_table_time")
  @@index([recordId])
  @@map("change_log")
}

enum ChangeLogOperation {
  INSERT
  UPDATE
  DELETE
}


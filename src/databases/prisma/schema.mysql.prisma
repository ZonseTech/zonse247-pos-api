// MODIFIED: Added saleId field and relation to Sale
model Transaction {
  id                       Int                       @id @default(autoincrement())
  transactionId            String                    @unique @map("transaction_id")
  externalTransactionRef   String?                   @map("external_transaction_ref")
  refNumber                String                    @map("ref_number")
  discount                 Decimal?                  @default(0.00) @map("discount")
  customerId               String?                   @map("customer_id")
  subtotal                 Decimal?                  @default(0.00) @map("subtotal")
  tax                      Decimal?                  @default(0.00) @map("tax")
  date                     DateTime?                 @map("date")
  paymentMethodId          String?                   @map("payment_method_id")
  phoneNumber              String?                   @map("phone_number")
  paymentServiceProviderId String?                   @map("payment_service_provider_id")
  total                    Decimal?                  @default(0.00) @map("total")
  paid                     Decimal?                  @default(0.00) @map("paid")
  changeAmount             Decimal?                  @default(0.00) @map("change_amount")
  terminalId               String?                   @map("terminal_id")
  userId                   String?                   @map("user_id")
  tenantId                 String                    @map("tenant_id")
  branchId                 String                    @map("branch_id")
  status                   String?                   @map("status")
  isRefund                 Boolean?                  @default(false) @map("is_refund")
  originalTransactionId    String?                   @map("original_transaction_id")
  refundReason             String?                   @map("refund_reason")
  refundedAmount           Decimal?                  @default(0.00) @map("refunded_amount")
  refundedAt               DateTime?                 @map("refunded_at")
  createdAt                DateTime?                 @default(now()) @map("created_at")
  updatedAt                DateTime?                 @default(now()) @map("updated_at")
  
  // ADDED: Link to Sale model
  saleId                   String?                   @map("sale_id")
  
  branch                   Branch                    @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)
  customer                 Customer?                 @relation(fields: [customerId], references: [customerId], onDelete: SetNull, onUpdate: NoAction, map: "fk_transactions_customer")
  user                     User?                     @relation(fields: [userId], references: [userId], onDelete: SetNull, onUpdate: NoAction)
  paymentMethod            PaymentMethod?            @relation(fields: [paymentMethodId], references: [methodId], onDelete: SetNull, onUpdate: NoAction)
  paymentServiceProvider   PaymentServiceProvider?   @relation(fields: [paymentServiceProviderId], references: [providerId], onDelete: SetNull, onUpdate: NoAction)
  terminal                 Terminal?                 @relation(fields: [terminalId], references: [terminalId], onDelete: SetNull, onUpdate: NoAction)
  refunds                  Transaction[]             @relation("RefundRelation")
  originalTransaction      Transaction?              @relation("RefundRelation", fields: [originalTransactionId], references: [transactionId], onUpdate: NoAction)
  sale                     Sale?                     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([customerId])
  @@index([userId])
  @@index([paymentMethodId])
  @@index([paymentServiceProviderId])
  @@index([terminalId])
  @@index([originalTransactionId])
  @@index([saleId])
  @@map("transactions")
}


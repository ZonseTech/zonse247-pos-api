generator client {
  provider = "prisma-client"
  output   = "./generated/mysql"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// INVENTORY BUSINESS FLOW MODELS
// ==========================================

// Product is the master/parent product (e.g., "Nivea Lotion")
// Contains common attributes shared across all variants
model Product {
  id          String     @id @default(uuid()) @map("product_id")
  tenantId    String     @map("tenant_id")
  branchId    String     @map("branch_id")
  terminalId  String?    @map("terminal_id")
  categoryId  String?    @map("category_id")
  name        String     @map("name")
  description String?    @map("description")
  
  // Brand info
  brand       String?    @map("brand")
  
  // Tax (applies to all variants unless overridden)
  isTaxable   Boolean?   @map("is_taxable")
  
  // Supplier info (common supplier for all variants)
  supplierName String?   @map("supplier_name")
  supplierCode String?   @map("supplier_code")
  
  // Default unit for variants (can be overridden per variant)
  defaultUnit String?    @map("default_unit")
  
  // Custom attributes schema (defines what custom fields variants can have)
  // e.g., ["color", "flavor", "material"] - JSON array
  customAttributeSchema String? @map("custom_attribute_schema") @db.Text
  
  // Image for the product (main product image)
  imageUrl    String?    @map("image_url")
  
  isActive    Boolean    @default(true) @map("is_active")
  version     Int        @default(1) @map("version")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch     @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  
  variants    ProductVariant[]  // All variants of this product
  
  @@unique([branchId, name], name: "unique_branch_product_name")
  @@index([branchId])
  @@index([tenantId])
  @@index([categoryId])
  @@index([name])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("products")
}

// ProductVariant is the sellable unit (e.g., "Nivea 50ml", "Nivea 200ml")
// Each variant has its own SKU, price, barcode, and inventory
model ProductVariant {
  id          String     @id @default(uuid()) @map("variant_id")
  productId   String     @map("product_id")
  tenantId    String     @map("tenant_id")
  branchId    String     @map("branch_id")
  
  // Variant identification
  sku         String?    @map("sku")
  variantName String     @map("variant_name")  // e.g., "50ml", "200ml", "Large"
  
  // Primary barcode for this variant
  primaryBarcode String? @map("primary_barcode")
  
  // Pricing
  sellingPrice Decimal   @default(0.00) @map("selling_price")
  costPrice    Decimal   @default(0.00) @map("cost_price")
  
  // Unit for this variant (overrides product default)
  unit        String     @default("piece") @map("unit")
  
  // Optional variant-level overrides (inherit from Product if null)
  description  String?   @map("description")
  brand        String?   @map("brand")
  imageUrl     String?   @map("image_url")
  isTaxable    Boolean?  @map("is_taxable")
  terminalId   String?   @map("terminal_id")
  supplierName String?   @map("supplier_name")
  supplierCode String?   @map("supplier_code")
  
  // Size/weight/volume attributes
  size        String?    @map("size")        // e.g., "Small", "Medium", "Large"
  weight      Decimal?   @map("weight")      // in grams/kg
  weightUnit  String?    @map("weight_unit") // "g", "kg", "oz", "lb"
  volume      Decimal?   @map("volume")      // in ml/L
  volumeUnit  String?    @map("volume_unit") // "ml", "L", "oz", "gal"
  dimensions  String?    @map("dimensions")  // "LxWxH"
  
  // Additional variant attributes (JSON for flexible custom properties)
  // e.g., {"color": "blue", "flavor": "vanilla", "material": "cotton"}
  customAttributes String? @map("custom_attributes") @db.Text
  
  // Promotional pricing (variant-specific)
  promoPrice  Decimal?   @map("promo_price")
  promoStart  DateTime?  @map("promo_start")
  promoEnd    DateTime?  @map("promo_end")
  
  // Dates
  expirationDate  DateTime? @map("expiration_date")
  manufactureDate DateTime? @map("manufacture_date")
  
  // Expiry date alert - days before expiration to trigger alert (e.g., 30 days)
  expiryDateAlert Int?      @map("expiry_date_alert")
  
  // Is this the default variant? (shown first in lists)
  isDefault   Boolean    @default(false) @map("is_default")
  
  isActive    Boolean    @default(true) @map("is_active")
  version     Int        @default(1) @map("version")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  // Relations
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch     @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  
  inventories Inventory[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  goodsReceiptItems GoodsReceiptItem[]
  supplierInvoiceItems SupplierInvoiceItem[]
  saleItems   SaleItem[]
  barcodes    VariantBarcode[]
  
  @@unique([productId, variantName], name: "unique_product_variant")
  @@unique([tenantId, branchId, primaryBarcode], name: "unique_tenant_branch_barcode")
  @@index([productId])
  @@index([branchId])
  @@index([tenantId])
  @@index([sku])
  @@index([primaryBarcode])
  @@index([variantName])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("product_variants")
}

// VariantBarcode - multiple barcodes per variant (replaces ProductBarcode)
model VariantBarcode {
  id          String      @id @default(uuid()) @map("variant_barcode_id")
  variantId   String      @map("variant_id")
  tenantId    String      @map("tenant_id")
  branchId    String      @map("branch_id")
  terminalId  String?     @map("terminal_id")
  barcode     String      @map("barcode")
  barcodeType BarcodeType @default(EAN13) @map("barcode_type")
  
  barcodeSource BarcodeSource @default(SUPPLIER) @map("barcode_source")
  description   String?       @map("description")
  
  isActive      Boolean    @default(true) @map("is_active")
  version       Int        @default(1) @map("version")
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  
  @@unique([tenantId, branchId, barcode], name: "unique_tenant_branch_barcode")
  @@unique([variantId, barcode], name: "unique_variant_barcode")
  @@index([variantId])
  @@index([tenantId])
  @@index([branchId])
  @@index([barcode])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("variant_barcodes")
}

// DEPRECATED: Keep for backward compatibility during migration
model ProductBarcode {
  id          String      @id @default(uuid()) @map("product_barcode_id")
  productId   String      @map("product_id")
  barcode     String      @unique @map("barcode")
  barcodeType BarcodeType @default(EAN13) @map("barcode_type")
  
  // ADDED: Barcode source/type classification
  barcodeSource BarcodeSource @default(SUPPLIER) @map("barcode_source")
  description   String?       @map("description")
  
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  
  @@unique([productId, barcode], name: "unique_product_barcode")
  @@index([productId])
  @@index([barcode]) // Critical for fast searches
  @@map("product_barcodes")
}

// ADD ENUM for barcode types
enum BarcodeType {
  EAN13       // 13-digit European Article Number
  EAN8        // 8-digit European Article Number
  UPCA        // 12-digit Universal Product Code
  UPCE        // 6-digit UPC
  CODE39      // Variable length alphanumeric
  CODE128     // Variable length high-density
  QR          // QR Code
  CUSTOM      // Custom barcode format
}

// ADD NEW ENUM for barcode sources
enum BarcodeSource {
  MANUFACTURER  // Original manufacturer barcode
  SUPPLIER      // Supplier/distributor barcode
  STORE         // Your store's internal barcode
  BUNDLE        // Barcode for product bundle
  PACKAGING     // Different packaging barcode (6-pack, case, etc.)
  CUSTOM        // Custom/alternate barcode
}

// ==========================================
// PROCUREMENT WORKFLOW MODELS
// ==========================================

model PurchaseRequisition {
  id                String                    @id @default(uuid()) @map("requisition_id")
  tenantId          String                    @map("tenant_id")
  branchId          String                    @map("branch_id")
  terminalId        String?                   @map("terminal_id")
  requisitionNumber String                    @map("requisition_number")
  requestedBy       String                    @map("requested_by")
  status            RequisitionStatus         @default(PENDING) @map("status")
  notes             String?                   @map("notes")
  approvedAt        DateTime?                 @map("approved_at")
  approvedBy        String?                   @map("approved_by")
  rejectedAt        DateTime?                 @map("rejected_at")
  rejectedBy        String?                   @map("rejected_by")
  rejectedReason    String?                   @map("rejected_reason")
  version           Int                       @default(1) @map("version")
  deletedAt         DateTime?                 @map("deleted_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant                    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch            Branch                    @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  requestedByUser   User                      @relation("requisitions_requested_by", fields: [requestedBy], references: [userId], onDelete: Restrict)
  approvedByUser    User?                     @relation("requisitions_approved_by", fields: [approvedBy], references: [userId], onDelete: SetNull)
  rejectedByUser    User?                     @relation("requisitions_rejected_by", fields: [rejectedBy], references: [userId], onDelete: SetNull)
  items             PurchaseRequisitionItem[]
  purchaseOrders    PurchaseOrder[]

  @@unique([tenantId, branchId, requisitionNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([requestedBy])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                String    @id @default(uuid()) @map("requisition_item_id")
  requisitionId     String    @map("requisition_id")
  variantId         String    @map("variant_id")
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  terminalId        String?   @map("terminal_id")
  requestedQuantity Int       @map("requested_quantity")
  approvedQuantity  Int?      @map("approved_quantity")
  notes             String?   @map("notes")
  version           Int       @default(1) @map("version")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch            Branch            @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([requisitionId, variantId])
  @@index([tenantId])
  @@index([branchId])
  @@index([variantId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("purchase_requisition_items")
}

model GoodsReceipt {
  id              String           @id @default(uuid()) @map("goods_receipt_id")
  tenantId        String           @map("tenant_id")
  branchId        String           @map("branch_id")
  terminalId      String?          @map("terminal_id")
  purchaseOrderId String           @map("purchase_order_id")
  receiptNumber   String           @map("receipt_number")
  status          GRNStatus        @default(DRAFT) @map("status")
  receivedAt      DateTime         @default(now()) @map("received_at")
  receivedBy      String           @map("received_by")
  notes           String?          @map("notes")
  version         Int              @default(1) @map("version")
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedByUser  User             @relation(fields: [receivedBy], references: [userId], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@unique([tenantId, branchId, receiptNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String    @id @default(uuid()) @map("goods_receipt_item_id")
  goodsReceiptId      String    @map("goods_receipt_id")
  purchaseOrderItemId String    @map("purchase_order_item_id")
  variantId           String    @map("variant_id")
  tenantId            String    @map("tenant_id")
  branchId            String    @map("branch_id")
  terminalId          String?   @map("terminal_id")
  receivedQuantity    Int       @map("received_quantity")
  rejectedQuantity    Int       @default(0) @map("rejected_quantity")
  rejectionReason     String?   @map("rejection_reason")
  unitCost            Decimal   @map("unit_cost") @db.Decimal(10, 2)
  totalCost           Decimal   @map("total_cost") @db.Decimal(10, 2)
  notes               String?   @map("notes")
  version             Int       @default(1) @map("version")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant              Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch              Branch            @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variant             ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([tenantId])
  @@index([branchId])
  @@index([purchaseOrderItemId])
  @@index([variantId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id              String          @id @default(uuid()) @map("supplier_invoice_id")
  tenantId        String          @map("tenant_id")
  branchId        String          @map("branch_id")
  terminalId      String?         @map("terminal_id")
  supplierId      String          @map("supplier_id")
  purchaseOrderId String?         @map("purchase_order_id")
  invoiceNumber   String          @map("invoice_number")
  invoiceDate     DateTime        @map("invoice_date")
  dueDate         DateTime?       @map("due_date")
  status          InvoiceStatus   @default(PENDING) @map("status")
  subtotal        Decimal         @default(0.00) @map("subtotal") @db.Decimal(10, 2)
  taxAmount       Decimal         @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal         @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  amountPaid      Decimal         @default(0.00) @map("amount_paid") @db.Decimal(10, 2)
  balanceDue      Decimal         @default(0.00) @map("balance_due") @db.Decimal(10, 2)
  notes           String?         @map("notes")
  version         Int             @default(1) @map("version")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items           SupplierInvoiceItem[]
  allocations     SupplierPaymentAllocation[]

  @@unique([tenantId, branchId, invoiceNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id                  String    @id @default(uuid()) @map("supplier_invoice_item_id")
  supplierInvoiceId   String    @map("supplier_invoice_id")
  purchaseOrderItemId String?   @map("purchase_order_item_id")
  variantId           String    @map("variant_id")
  tenantId            String    @map("tenant_id")
  branchId            String    @map("branch_id")
  terminalId          String?   @map("terminal_id")
  quantity            Int       @map("quantity")
  unitPrice           Decimal   @map("unit_price") @db.Decimal(10, 2)
  taxRate             Decimal?  @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal   @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount      Decimal   @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalPrice          Decimal   @map("total_price") @db.Decimal(10, 2)
  notes               String?   @map("notes")
  version             Int       @default(1) @map("version")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant              Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch              Branch             @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  supplierInvoice     SupplierInvoice    @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  variant             ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([supplierInvoiceId, purchaseOrderItemId], map: "sup_inv_items_invoice_id_po_item_id_key")
  @@index([tenantId])
  @@index([branchId])
  @@index([purchaseOrderItemId])
  @@index([variantId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("supplier_invoice_items")
}

model SupplierPayment {
  id                String        @id @default(uuid()) @map("supplier_payment_id")
  tenantId          String        @map("tenant_id")
  branchId          String        @map("branch_id")
  terminalId        String?       @map("terminal_id")
  supplierId        String        @map("supplier_id")
  paymentNumber     String        @map("payment_number")
  paymentDate       DateTime      @default(now()) @map("payment_date")
  amount            Decimal       @map("amount") @db.Decimal(10, 2)
  paymentMethod     String?       @map("payment_method")
  reference         String?       @map("reference")
  status            PaymentStatus @default(COMPLETED) @map("status")
  notes             String?       @map("notes")
  version           Int           @default(1) @map("version")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch            Branch           @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations       SupplierPaymentAllocation[]

  @@unique([tenantId, branchId, paymentNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id              String   @id @default(uuid()) @map("allocation_id")
  tenantId        String   @map("tenant_id")
  branchId        String   @map("branch_id")
  terminalId      String?  @map("terminal_id")
  paymentId       String   @map("payment_id")
  invoiceId       String   @map("invoice_id")
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(10, 2)
  allocatedDate   DateTime @default(now()) @map("allocated_date")
  notes           String?  @map("notes")
  version         Int      @default(1) @map("version")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  payment         SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice         SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId], name: "unique_payment_invoice")
  @@index([tenantId])
  @@index([branchId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("supplier_payment_allocations")
}

model Supplier {
  id          String          @id @default(uuid()) @map("supplier_id")
  tenantId    String          @map("tenant_id")
  branchId    String          @map("branch_id")
  terminalId  String?         @map("terminal_id")
  name        String          @map("name")
  contactPerson String?       @map("contact_person")
  email       String?         @map("email")
  phone       String?         @map("phone")
  address     String?         @map("address")
  taxId       String?         @map("tax_id")
  paymentTerms PaymentTerms   @default(CASH_ON_DELIVERY) @map("payment_terms")
  creditLimit Decimal         @default(0) @map("credit_limit") @db.Decimal(10, 2)
  status      SupplierStatus  @default(ACTIVE) @map("status")
  isActive    Boolean         @default(true) @map("is_active")
  version     Int             @default(1) @map("version")
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  
  tenant      Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch          @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  
  @@index([branchId])
  @@index([tenantId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String               @id @default(uuid()) @map("purchase_order_id")
  tenantId    String               @map("tenant_id")
  branchId    String               @map("branch_id")
  terminalId  String?              @map("terminal_id")
  supplierId  String               @map("supplier_id")
  requisitionId String?             @map("requisition_id")
  poNumber    String               @map("po_number")
  status      PurchaseOrderStatus  @default(PENDING) @map("status")
  orderDate   DateTime             @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?   @map("expected_delivery_date")
  receivedAt  DateTime?            @map("received_at")
  notes       String?              @map("notes")
  createdBy   String               @map("created_by")
  receivedBy  String?              @map("received_by")
  isLocked    Boolean              @default(false) @map("is_locked")
  version     Int                  @default(1) @map("version")
  deletedAt   DateTime?            @map("deleted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  
  tenant      Tenant               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch               @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  createdByUser User               @relation("purchase_orders_created_by", fields: [createdBy], references: [userId], onDelete: Restrict)
  receivedByUser User?             @relation("purchase_orders_received_by", fields: [receivedBy], references: [userId], onDelete: SetNull)
  
  @@index([branchId])
  @@unique([tenantId, poNumber], name: "unique_tenant_po_number")
  @@index([tenantId])
  @@index([supplierId])
  @@index([requisitionId])
  @@index([status])
  @@index([poNumber])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @map("purchase_order_item_id")
  tenantId        String   @map("tenant_id")
  branchId        String   @map("branch_id")
  purchaseOrderId String   @map("purchase_order_id")
  variantId       String   @map("variant_id")
  terminalId      String?  @map("terminal_id")
  orderedQuantity Int      @default(0) @map("ordered_quantity")
  receivedQuantity Int     @default(0) @map("received_quantity")
  damagedQuantity Int      @default(0) @map("damaged_quantity")
  unitPrice       Decimal  @default(0.00) @map("unit_price")
  totalPrice      Decimal  @default(0.00) @map("total_price")
  notes           String?  @map("notes")
  version         Int      @default(1) @map("version")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  tenant        Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]
  supplierInvoiceItems SupplierInvoiceItem[]
  
  @@unique([purchaseOrderId, variantId], name: "unique_po_variant")
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId, updatedAt])
  @@index([purchaseOrderId])
  @@index([variantId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("purchase_order_items")
}

model Inventory {
  id                String         @id @default(uuid()) @map("inventory_id")
  tenantId          String         @map("tenant_id")
  branchId          String         @map("branch_id")
  terminalId        String?        @map("terminal_id")
  productId         String         @map("product_id")
  variantId         String?        @map("variant_id")
  
  availableQuantity Int            @default(0) @map("available_quantity")
  reservedQuantity  Int            @default(0) @map("reserved_quantity")
  damagedQuantity   Int            @default(0) @map("damaged_quantity")
  
  averageCost       Decimal        @default(0.00) @map("average_cost")
  lastPurchaseCost  Decimal        @default(0.00) @map("last_purchase_cost")
  
  reorderPoint      Int?           @map("reorder_point")
  maxStock          Int?           @map("max_stock")
  trackInventory    Boolean        @default(true) @map("track_inventory")
  allowNegativeStock Boolean       @default(false) @map("allow_negative_stock")
  
  lastRestockedAt   DateTime?      @map("last_restocked_at")
  lastSoldAt        DateTime?      @map("last_sold_at")
  version           Int            @default(1) @map("version")
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  
  tenant            Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch            Branch         @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  
  @@unique([branchId, variantId], name: "unique_branch_variant")
  @@index([branchId])
  @@index([tenantId])
  @@index([variantId])
  @@index([productId])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("inventory")
}

model StockMovement {
  id              String            @id @default(uuid()) @map("stock_movement_id")
  tenantId        String            @map("tenant_id")
  branchId        String            @map("branch_id")
  terminalId      String?           @map("terminal_id")
  inventoryId     String            @map("inventory_id")
  
  movementType    StockMovementType @map("movement_type")
  quantity        Int               @map("quantity")
  previousQuantity Int              @map("previous_quantity")
  newQuantity     Int               @map("new_quantity")
  
  referenceType   StockReferenceType? @map("reference_type")
  referenceId     String?            @map("reference_id")
  
  unitCost        Decimal           @default(0.00) @map("unit_cost")
  totalCost       Decimal           @default(0.00) @map("total_cost")
  
  notes           String?           @map("notes")
  movedBy         String            @map("moved_by")
  movementDate    DateTime          @default(now()) @map("movement_date")
  version         Int               @default(1) @map("version")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  
  tenant          Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  inventory       Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  movedByUser     User              @relation(fields: [movedBy], references: [userId], onDelete: Restrict)
  
  @@index([branchId])
  @@index([tenantId])
  @@index([inventoryId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([movementDate])
  @@index([tenantId, branchId, movementDate])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("stock_movements")
}

model Sale {
  id              String        @id @default(uuid()) @map("sale_id")
  tenantId        String        @map("tenant_id")
  branchId        String        @map("branch_id")
  saleNumber      String        @map("sale_number")
  
  customerId      String?       @map("customer_id")
  terminalId      String?       @map("terminal_id")
  userId          String        @map("user_id")
  
  subtotal        Decimal       @default(0.00) @map("subtotal")
  taxAmount       Decimal       @default(0.00) @map("tax_amount")
  discountAmount  Decimal       @default(0.00) @map("discount_amount")
  otherCharges    Decimal       @default(0.00) @map("other_charges")
  totalAmount     Decimal       @default(0.00) @map("total_amount")
  
  amountPaid      Decimal       @default(0.00) @map("amount_paid")
  changeAmount    Decimal       @default(0.00) @map("change_amount")
  paymentMethodId String?       @map("payment_method_id")
  
  status          SaleStatus    @default(COMPLETED) @map("status")
  saleDate        DateTime      @default(now()) @map("sale_date")
  notes           String?       @map("notes")
  
  isVoided        Boolean       @default(false) @map("is_voided")
  voidedAt        DateTime?     @map("voided_at")
  voidedBy        String?       @map("voided_by")
  voidReason      String?       @map("void_reason")
  
  // MRA (Malawi Revenue Authority) fields
  mraSubmissionId   String?        @map("mra_submission_id")
  mraResponseCode   String?        @map("mra_response_code")
  mraResponseDesc   String?        @map("mra_response_desc")
  mraQrCode         String?        @map("mra_qr_code") @db.Text   // base64 or URL
  mraVerificationUrl String?       @map("mra_verification_url")
  mraStatus         MraSaleStatus? @default(NONE) @map("mra_status")
  mraLastSyncAt     DateTime?      @map("mra_last_sync_at")
  
  version         Int           @default(1) @map("version")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  tenant          Tenant        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [customerId], onDelete: SetNull, map: "fk_sales_customer")
  terminal        Terminal?     @relation(fields: [terminalId], references: [terminalId], onDelete: SetNull)
  user            User          @relation(fields: [userId], references: [userId], onDelete: Restrict)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [methodId], onDelete: SetNull)
  items           SaleItem[]
  voidedByUser    User?         @relation("sales_voided_by", fields: [voidedBy], references: [userId], onDelete: SetNull)
  transactions    Transaction[]
  payments        SalePayment[] // NEW: Support for multiple payment methods
  mraSubmission   MraSubmission? // Central server MRA submission tracking
  
  @@unique([tenantId, branchId, saleNumber], name: "unique_tenant_branch_sale_number")
  @@index([branchId])
  @@index([tenantId])
  @@index([customerId])
  @@index([terminalId])
  @@index([userId])
  @@index([saleDate])
  @@index([saleNumber])
  @@index([tenantId, branchId, updatedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([mraStatus])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(uuid()) @map("sale_item_id")
  tenantId        String   @map("tenant_id")
  branchId        String   @map("branch_id")
  saleId          String   @map("sale_id")
  productId       String   @map("product_id")  // Legacy field - parent product ID
  variantId       String   @map("variant_id")
  terminalId      String?  @map("terminal_id")
  
  quantity        Int      @map("quantity")
  unitPrice       Decimal  @map("unit_price")
  unitCost        Decimal  @default(0.00) @map("unit_cost")
  
  subtotal        Decimal  @map("subtotal")
  taxAmount       Decimal  @default(0.00) @map("tax_amount")
  discountAmount  Decimal  @default(0.00) @map("discount_amount")
  totalAmount     Decimal  @map("total_amount")
  
  version         Int      @default(1) @map("version")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  tenant          Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  @@unique([saleId, variantId], name: "unique_sale_variant")
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId, updatedAt])
  @@index([saleId])
  @@index([variantId])
  @@index([productId])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("sale_items")
}

// ==========================================
// MULTIPLE PAYMENT SUPPORT (Split Payments)
// ==========================================
// Allows a single sale to have multiple payment methods
// e.g., K5,000 cash + K3,000 card for a K8,000 total
// Backward compatible: existing sales with single paymentMethodId continue to work

model SalePayment {
  id              String        @id @default(uuid()) @map("sale_payment_id")
  tenantId        String        @map("tenant_id")
  branchId        String        @map("branch_id")
  saleId          String        @map("sale_id")
  paymentMethodId String        @map("payment_method_id")
  terminalId      String?       @map("terminal_id")
  
  amount          Decimal       @map("amount") @db.Decimal(10, 2)
  reference       String?       @map("reference")         // Card ref, mobile money transaction ID, etc.
  
  // Payment provider info (for mobile money, card payments, etc.)
  providerId      String?       @map("provider_id")       // Links to payment service provider
  providerRef     String?       @map("provider_ref")      // External reference from provider
  
  status          PaymentStatus @default(COMPLETED) @map("status")
  processedAt     DateTime      @default(now()) @map("processed_at")
  
  notes           String?       @map("notes")
  lastSyncedAt    DateTime?     @map("last_synced_at")
  version         Int           @default(1) @map("version")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  tenant          Tenant        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [methodId], onDelete: Restrict)
  
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId, updatedAt])
  @@index([saleId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([processedAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("sale_payments")
}

// ==========================================
// ORIGINAL MODELS (unchanged except for noted modifications)
// ==========================================

model MRA_API_CONFIG_TABLE {
  configId          String                            @id @default(uuid()) @map("config_id")
  tenantId          String                            @map("tenant_id")
  environment       MRA_API_CONFIG_TABLE_environment? @default(SANDBOX) @map("environment")
  apiBaseUrl        String                            @map("api_base_url")
  apiKey            String?                           @db.Text @map("api_key")
  apiSecret         String?                           @db.Text @map("api_secret")
  lastSyncTimestamp DateTime?                         @map("last_sync_timestamp")
  syncStatus        MRA_API_CONFIG_TABLE_sync_status? @default(SUCCESS) @map("sync_status")
  isActive          Boolean?                          @default(true) @map("is_active")
  createdAt         DateTime?                         @default(now()) @map("created_at")
  updatedAt         DateTime?                         @default(now()) @map("updated_at")
  tenant            Tenant                            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, environment], name: "unique_tenant_env")
  @@map("mra_api_config_table")
}

// MRA submission tracking (Central MySQL server only - not synced to SQLite)
model MraSubmission {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  branchId        String              @map("branch_id")
  terminalId      String?             @map("terminal_id")
  saleId          String              @unique @map("sale_id")
  status          MraSubmissionStatus @default(PENDING) @map("status")
  attemptCount    Int                 @default(0) @map("attempt_count")
  lastAttemptAt   DateTime?           @map("last_attempt_at")
  nextAttemptAt   DateTime?           @map("next_attempt_at")
  requestPayload  Json?               @map("request_payload")
  responsePayload Json?               @map("response_payload")
  errorMessage    String?             @map("error_message") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [branchId], onDelete: Cascade)

  @@index([status])
  @@index([nextAttemptAt])
  @@index([tenantId])
  @@index([branchId])
  @@map("mra_submissions")
}

model AuditLog {
  id             Int                @id @default(autoincrement())
  logId          String             @unique @map("log_id")
  tenantId       String?            @map("tenant_id")
  branchId       String?            @map("branch_id")
  userId         String?            @map("user_id")
  terminalId     String?            @map("terminal_id")
  actionType     AuditLogActionType @map("action_type")
  entityType     String             @map("entity_type")
  entityId       String?            @map("entity_id")
  entityName     String?            @map("entity_name")
  oldValues      Json?              @map("old_values")
  newValues      Json?              @map("new_values")
  changesSummary String?            @map("changes_summary")
  ipAddress      String?            @map("ip_address")
  userAgent      String?            @map("user_agent")
  requestMethod  String?            @map("request_method")
  requestUrl     String?            @map("request_url")
  description    String?            @map("description")
  severity       AuditLogSeverity?  @default(low) @map("severity")
  createdAt      DateTime?          @default(now()) @map("created_at")
  tenant         Tenant?            @relation(fields: [tenantId], references: [tenantId], onUpdate: NoAction)
  branch         Branch?            @relation(fields: [branchId], references: [branchId], onUpdate: NoAction)
  user           User?              @relation(fields: [userId], references: [userId], onUpdate: NoAction)
  terminal       Terminal?          @relation(fields: [terminalId], references: [terminalId], onUpdate: NoAction)

  @@index([actionType])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId])
  @@index([terminalId])
  @@index([userId])
  @@map("audit_logs")
}

// District model for Malawi districts
model District {
  id          Int       @id @default(autoincrement())
  districtId  String    @unique @map("district_id")
  name        String    @map("name")
  region      String    @map("region") // Northern, Central, Southern
  code        String    @unique @map("code") // District code (e.g., DOW for Dowa)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  branches    Branch[]
  
  @@index([region])
  @@index([isActive])
  @@map("districts")
}

model BranchSetting {
  id              Int                  @id @default(autoincrement())
  branchSettingId String               @unique @map("branch_setting_id")
  tenantId        String               @map("tenant_id")
  branchId        String               @unique @map("branch_id")
  terminalId      String               @map("terminal_id")
  app             String?              @map("app")
  store           String?              @map("store")
  addressLine1    String?              @map("address_line1")
  addressLine2    String?              @map("address_line2")
  country         String?              @map("country")
  city            String?              @map("city")
  contact         String?              @map("contact")
  tax             String?              @map("tax")
  symbol          String?              @map("symbol")
  footer          String?              @map("footer")
  status          BranchSettingStatus? @default(inactive) @map("status")
  createdAt       DateTime?            @default(now()) @map("created_at")
  updatedAt       DateTime?            @default(now()) @map("updated_at")
  branch          Branch               @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)

  @@index([branchId])
  @@map("branch_settings")
}

model Branch {
  id                 Int                      @id @default(autoincrement())
  branchId           String                   @unique @map("branch_id")
  tenantId           String                   @map("tenant_id")
  branchName         String                   @map("branch_name")
  branchCode         String                   @map("branch_code")
  siteId             String?                  @map("site_id")
  siteName           String?                  @map("site_name")
  description        String?                  @map("description")
  addressLine1       String?                  @map("address_line_1")
  addressLine2       String?                  @map("address_line_2")
  addressLine3       String?                  @map("address_line_3")
  districtId         String?                  @map("district_id")
  location           String?                  @map("location")
  businessType       BusinessType?            @default(PRODUCT_BASED) @map("business_type")
  city               String?                  @map("city")
  state              String?                  @map("state")
  postalCode         String?                  @map("postal_code")
  phoneNumber        String?                  @map("phone_number")
  email              String?                  @map("email")
  currencyCode       String?                  @default("MKW") @map("currency_code")
  currencySymbol     String?                  @default("K") @map("currency_symbol")
  taxRate            Decimal?                 @default(0.00) @map("tax_rate")
  chargeTax          Boolean?                 @default(false) @map("charge_tax")
  receiptFooter      String?                  @map("receipt_footer")
  logoUrl            String?                  @map("logo_url")
  isVirtualWarehouse Boolean?                 @default(false) @map("is_virtual_warehouse")
  isActive           Boolean?                 @default(true) @map("is_active")
  mraApprovalStatus      BranchMRAApprovalStatus? @default(PENDING) @map("mra_approval_status")
  mraApprovalDate        DateTime?                @map("mra_approval_date")
  branchSubscriptionId   String?                  @unique @map("branch_subscription_id")
  status                 BranchStatus?            @default(active) @map("status")
  createdAt              DateTime?                @default(now()) @map("created_at")
  updatedAt              DateTime?                @default(now()) @map("updated_at")
  version                Int                      @default(1) @map("version")
  deletedAt              DateTime?                @map("deleted_at")

  auditLogs          AuditLog[]
  branchSetting      BranchSetting?
  tenant             Tenant                   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)
  districtRef        District?                @relation(fields: [districtId], references: [districtId], onUpdate: NoAction)
  branchSubscription BranchSubscription?      @relation(fields: [branchSubscriptionId], references: [branchSubscriptionId], onUpdate: NoAction)
  categories         Category[]
  customers          Customer[]
  serviceProviders   ServiceProvider[]
  terminals          Terminal[]
  transactions       Transaction[]
  userPermissions    UserPermission[]
  usersBranch        User[]                   @relation("users_branch_idTobranches")
  usersCurrentBranch User[]                   @relation("users_current_branch_idTobranches")
  
  // ADDED: New inventory flow relations
  products           Product[]
  productVariants    ProductVariant[]
  variantBarcodes    VariantBarcode[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseRequisitions       PurchaseRequisition[]
  purchaseRequisitionItems   PurchaseRequisitionItem[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptItems  GoodsReceiptItem[]
  supplierInvoices   SupplierInvoice[]
  supplierInvoiceItems SupplierInvoiceItem[]
  supplierPayments   SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  inventories        Inventory[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleItems          SaleItem[]
  salePayments       SalePayment[]
  paymentMethods     PaymentMethod[]
  parkedSaleItems    ParkedSaleItem[]
  printers           Printer[]
  staff              Staff[]
  mraSubmissions     MraSubmission[] // Central server only
  terminalSyncStates TerminalSyncState[] // Server-only: sync state tracking
  changeLogs         ChangeLog[] // Server-only: change log for delta sync

  @@unique([tenantId, branchCode], name: "unique_tenant_branch_code")
  @@index([branchCode])
  @@index([tenantId, isActive])
  @@index([tenantId])
  @@index([branchSubscriptionId])
  @@index([deletedAt], map: "idx_branches_deleted_at")
  @@map("branches")
}

model Category {
  id          Int         @id @default(autoincrement())
  categoryId  String      @unique @map("category_id")
  branchId    String      @map("branch_id")
  tenantId    String      @map("tenant_id")
  userId      String      @map("user_id")
  terminalId  String?     @map("terminal_id")

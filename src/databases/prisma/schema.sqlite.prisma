model Staff {
  id                       Int               @id @default(autoincrement())
  staffId                  String            @unique @map("staff_id")
  userId                   String            @unique @map("user_id")
  tenantId                 String            @map("tenant_id")
  branchId                 String            @map("branch_id")
  employeeCode             String?           @map("employee_code")
  department               String?           @map("department")
  designation              String?           @map("designation")
  joiningDate              DateTime?         @map("joining_date")
  terminationDate          DateTime?         @map("termination_date")
  calculateAs              CalculateAs       @default(DAILY) @map("calculate_as")
  staffSalary              Float             @default(0.00) @map("staff_salary")
  salaryFrequency          SalaryFrequency   @default(MONTHLY) @map("salary_frequency")
  trackAttendance          Boolean           @default(false) @map("track_attendance")
  allowSelfAttendance      Boolean           @default(false) @map("allow_self_attendance")
  attendanceType           AttendanceType    @default(PUNCH) @map("attendance_type")
  avgShiftHours            Float             @default(8.00) @map("avg_shift_hours")
  allowAppAccess           Boolean           @default(false) @map("allow_app_access")
  emergencyContactName     String?           @map("emergency_contact_name")
  emergencyContactPhone    String?           @map("emergency_contact_phone")
  emergencyContactRelation String?           @map("emergency_contact_relation")
  address                  String?           @map("address")
  city                     String?           @map("city")
  state                    String?           @map("state")
  postalCode               String?           @map("postal_code")
  country                  String?           @map("country")
  nationalId               String?           @map("national_id")
  dateOfBirth              DateTime?         @map("date_of_birth")
  gender                   Gender?           @map("gender")
  bankName                 String?           @map("bank_name")
  bankAccountNumber        String?           @map("bank_account_number")
  bankBranchCode           String?           @map("bank_branch_code")
  employmentStatus         EmploymentStatus  @default(ACTIVE) @map("employment_status")
  notes                    String?           @map("notes")
  synced                   Int               @default(0) @map("synced")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  user                     User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tenant                   Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch                   Branch            @relation(fields: [branchId], references: [branchId], onDelete: Cascade)

  @@unique([tenantId, employeeCode], name: "unique_tenant_employee_code")
  @@index([userId], name: "idx_staff_user_id")
  @@index([tenantId], name: "idx_staff_tenant_id")
  @@index([branchId], name: "idx_staff_branch_id")
  @@index([employmentStatus], name: "idx_staff_employment_status")
  @@index([joiningDate], name: "idx_staff_joining_date")
  @@map("staff")
}
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model MRA_API_CONFIG_TABLE {
  configId           String                            @id @default(uuid()) @map("config_id")
  tenantId           String                            @map("tenant_id")
  environment        MRA_API_CONFIG_TABLE_environment? @default(SANDBOX) @map("environment")
  apiBaseUrl         String                            @map("api_base_url")
  apiKey             String?                           @map("api_key")
  apiSecret          String?                           @map("api_secret")
  lastSyncTimestamp  DateTime?                         @map("last_sync_timestamp")
  syncStatus         MRA_API_CONFIG_TABLE_sync_status? @default(SUCCESS) @map("sync_status")
  isActive           Boolean?                          @default(true) @map("is_active")
  createdAt          DateTime?                         @default(now()) @map("created_at")
  updatedAt          DateTime?                         @default(now()) @map("updated_at")
  tenant             Tenant                            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, environment], name: "unique_tenant_env")
  @@map("MRA_API_CONFIG_TABLE")
}

model AuditLog {
  id              Int                    @id @default(autoincrement())
  logId           String                 @unique @map("log_id")
  tenantId        String?                @map("tenant_id")
  branchId        String?                @map("branch_id")
  userId          String?                @map("user_id")
  terminalId      String?                @map("terminal_id")
  actionType      AuditLogActionType     @map("action_type")
  entityType      String                 @map("entity_type")
  entityId        String?                @map("entity_id")
  entityName      String?                @map("entity_name")
  oldValues       Json?                  @map("old_values")
  newValues       Json?                  @map("new_values")
  changesSummary  String?                @map("changes_summary")
  ipAddress       String?                @map("ip_address")
  userAgent       String?                @map("user_agent")
  requestMethod   String?                @map("request_method")
  requestUrl      String?                @map("request_url")
  description     String?                @map("description")
  synced          Int?                   @default(0) @map("synced")
  severity        AuditLogSeverity?      @default(low) @map("severity")
  createdAt       DateTime?              @default(now()) @map("created_at")
  tenant          Tenant?                @relation(fields: [tenantId], references: [tenantId], onUpdate: NoAction)
  branch          Branch?                @relation(fields: [branchId], references: [branchId], onUpdate: NoAction)
  user            User?                  @relation(fields: [userId], references: [userId], onUpdate: NoAction)
  terminal        Terminal?              @relation(fields: [terminalId], references: [terminalId], onUpdate: NoAction)

  @@index([actionType])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId])
  @@index([terminalId])
  @@index([userId])
  @@map("audit_logs")
}

model BranchSetting {
  id                Int                     @id @default(autoincrement())
  branchSettingId   String                  @unique @map("branch_setting_id")
  tenantId          String                  @map("tenant_id")
  branchId          String                  @unique @map("branch_id")
  terminalId        String                  @map("terminal_id")
  app               String?                 @map("app")
  store             String?                 @map("store")
  addressLine1      String?                 @map("address_line1")
  addressLine2      String?                 @map("address_line2")
  country           String?                 @map("country")
  city              String?                 @map("city")
  contact           String?                 @map("contact")
  tax               String?                 @map("tax")
  symbol            String?                 @map("symbol")
  footer            String?                 @map("footer")
  status            BranchSettingStatus?    @default(inactive) @map("status")
  synced            Int?                    @default(0) @map("synced")
  createdAt         DateTime?               @default(now()) @map("created_at")
  updatedAt         DateTime?               @default(now()) @map("updated_at")
  branch            Branch                  @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)

  @@index([branchId])
  @@map("branch_settings")
}

model Branch {
  id                                      Int                           @id @default(autoincrement())
  branchId                                String                        @unique @map("branch_id")
  tenantId                                String                        @map("tenant_id")
  branchName                              String                        @map("branch_name")
  branchCode                              String                        @map("branch_code")
  siteId                                  String?                       @map("site_id")
  siteName                                String?                       @map("site_name")
  description                             String?                       @map("description")
  addressLine1                            String?                       @map("address_line_1")
  addressLine2                            String?                       @map("address_line_2")
  addressLine3                            String?                       @map("address_line_3")
  district                                String?                       @map("district")
  city                                    String?                       @map("city")
  state                                   String?                       @map("state")
  postalCode                              String?                       @map("postal_code")
  phoneNumber                             String?                       @map("phone_number")
  email                                   String?                       @map("email")
  currencyCode                            String?                       @default("MKW") @map("currency_code")
  currencySymbol                          String?                       @default("K") @map("currency_symbol")
  taxRate                                 Decimal?                      @default(0.00) @map("tax_rate")
  chargeTax                               Boolean?                      @default(false) @map("charge_tax")
  receiptFooter                           String?                       @map("receipt_footer")
  logoUrl                                 String?                       @map("logo_url")
  isVirtualWarehouse                      Boolean?                      @default(false) @map("is_virtual_warehouse")
  isActive                                Boolean?                      @default(true) @map("is_active")
  synced                                  Int?                          @default(0) @map("synced")
  mraApprovalStatus                       BranchMRAApprovalStatus?      @default(PENDING) @map("mra_approval_status")
  mraApprovalDate                         DateTime?                     @map("mra_approval_date")
  status                                  BranchStatus?                 @default(active) @map("status")
  createdAt                               DateTime?                     @default(now()) @map("created_at")
  updatedAt                               DateTime?                     @default(now()) @map("updated_at")
  auditLogs                               AuditLog[]
  branchSetting                           BranchSetting?
  tenant                                  Tenant                        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)
  categories                              Category[]
  customers                               Customer[]
  inventory                               Inventory[]
  paymentMethods                          PaymentMethod[]
  serviceProviders                        ServiceProvider[]
  terminals                               Terminal[]
  transactions                            Transaction[]
  userPermissions                         UserPermission[]
  usersBranch                             User[]                        @relation("users_branch_idTobranches")
  usersCurrentBranch                      User[]                        @relation("users_current_branch_idTobranches")

  @@unique([tenantId, branchCode], name: "unique_tenant_branch_code")
  @@index([branchCode])
  @@index([tenantId, isActive])
  @@index([tenantId])
  @@map("branches")
}

model Category {
  id          Int         @id @default(autoincrement())
  categoryId  String      @unique @map("category_id")
  branchId    String      @map("branch_id")
  tenantId    String      @map("tenant_id")
  userId      String      @map("user_id")
  terminalId  String      @map("terminal_id")
  name        String      @map("name")
  description String?     @map("description")
  color       String?     @map("color")
  isActive    Boolean?    @default(true) @map("is_active")
  sortOrder   Int?        @default(0) @map("sort_order")
  itemCount   Int?        @map("item_count")
  synced      Int?        @default(0) @map("synced")
  createdAt   DateTime?   @default(now()) @map("created_at")
  updatedAt   DateTime?   @default(now()) @map("updated_at")
  branch      Branch      @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)
  terminal    Terminal    @relation(fields: [terminalId], references: [terminalId], onDelete: Cascade, onUpdate: NoAction)
  inventory   Inventory[]

  @@unique([branchId, name], name: "unique_branch_category")
  @@index([branchId])
  @@index([terminalId])
  @@map("categories")
}

model Customer {
  id          Int       @id @default(autoincrement())
  customerId  String    @unique @map("customer_id")
  tenantId    String    @map("tenant_id")
  branchId    String    @map("branch_id")
  userId      String?   @map("user_id")
  name        String    @map("name")
  synced      Int?      @default(0) @map("synced")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")
  branch      Branch    @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)

  @@index([branchId])
  @@map("customers")
}

model Inventory {
  id                                     Int               @id @default(autoincrement())
  productId                              String            @unique @map("product_id")
  branchId                               String            @map("branch_id")
  tenantId                               String            @map("tenant_id")
  userId                                 String            @map("user_id")
  categoryId                             String?           @map("category_id")
  barcode                                String            @map("barcode")
  sku                                    String?           @map("sku")
  name                                   String            @map("name")
  description                            String?           @map("description")
  brand                                  String?           @map("brand")
  unit                                   String?           @default("piece") @map("unit")
  costPrice                              Decimal           @default(0.00) @map("cost_price")
  sellPrice                              Decimal           @default(0.00) @map("sell_price")
  promoPrice                             Decimal?          @map("promo_price")
  promoStart                             DateTime?         @map("promo_start")
  promoEnd                               DateTime?         @map("promo_end")
  quantity                               String?           @default("0") @map("quantity")
  reservedQuantity                       Int?              @default(0) @map("reserved_quantity")
  minStock                               Int?              @default(0) @map("min_stock")
  originalQuantity                       String?           @default("0") @map("original_quantity")
  maxStock                               Int?              @map("max_stock")
  stock                                  Int?              @map("stock")
  reorderLevel                           Int?              @map("reorder_level")
  weight                                 Decimal?          @map("weight")
  dimensions                             String?           @map("dimensions")
  color                                  String?           @map("color")
  size                                   String?           @map("size")
  properties                             Json?             @map("properties")
  status                                 InventoryStatus?  @default(active) @map("status")
  trackInventory                         Boolean?          @default(true) @map("track_inventory")
  allowNegativeStock                     Boolean?          @default(false) @map("allow_negative_stock")
  isTaxable                              Boolean?          @default(true) @map("is_taxable")
  expirationDate                         DateTime?         @map("expiration_date")
  manufactureDate                        DateTime?         @map("manufacture_date")
  imageUrls                              Json?             @map("image_urls")
  supplierName                           String?           @map("supplier_name")
  supplierCode                           String?           @map("supplier_code")
  createdBy                              String?           @map("created_by")
  lastUpdatedBy                          String?           @map("last_updated_by")
  synced                                 Int?              @default(0) @map("synced")
  createdAt                              DateTime?         @default(now()) @map("created_at")
  updatedAt                              DateTime?         @default(now()) @map("updated_at")
  branch                                 Branch            @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)
  category                               Category?         @relation(fields: [categoryId], references: [categoryId], onUpdate: NoAction)
  createdByUser                          User?             @relation("inventory_created_byTousers", fields: [createdBy], references: [userId], onUpdate: NoAction)
  lastUpdatedByUser                      User?             @relation("inventory_last_updated_byTousers", fields: [lastUpdatedBy], references: [userId], onUpdate: NoAction)

  @@index([createdBy])
  @@index([barcode])
  @@index([branchId])
  @@index([categoryId])
  @@index([name])
  @@index([status])
  @@index([lastUpdatedBy])
  @@map("inventory")
}

model Order {
  id             Int       @id @default(autoincrement())
  orderId        String    @unique @map("order_id")
  refNumber      String    @map("ref_number")
  transactionId  String?   @default("1") @map("transaction_id")
  productId      String    @map("product_id")
  quantity       Decimal   @default(1.000) @map("quantity")
  purchasePrice  Decimal   @default(0.00) @map("purchase_price")
  sellPrice      Decimal   @default(0.00) @map("sell_price")
  synced         Int?      @default(0) @map("synced")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  @@index([transactionId])
  @@map("orders")
}

model PaymentMethod {
  id         Int       @id @default(autoincrement())
  methodId   String    @unique @map("method_id")
  branchId   String    @map("branch_id")
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  name       String    @map("name")
  isActive   Boolean?  @default(true) @map("is_active")
  icon       String?   @map("icon")
  sortOrder  Int?      @default(0) @map("sort_order")
  synced     Int?      @default(0) @map("synced")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")
  branch     Branch    @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)
  tenant     Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branchId, name], name: "unique_branch_payment_method")
  @@unique([tenantId, name], name: "unique_tenant_payment_method")
  @@unique([userId, name], name: "unique_user_payment_method")
  @@index([branchId])
  @@index([tenantId])
  @@index([userId])
  @@map("payment_methods")
}

model Permission {
  id                   Int                @id @default(autoincrement())
  permissionId         String             @unique @map("permission_id")
  name                 String             @unique @map("name")
  displayName          String             @map("display_name")
  description          String?            @map("description")
  category             String             @map("category")
  scope                PermissionScope?   @default(shop) @map("scope")
  synced               Int?               @default(0) @map("synced")
  isSystemPermission   Boolean?           @default(true) @map("is_system_permission")
  createdAt            DateTime?          @default(now()) @map("created_at")
  updatedAt            DateTime?          @default(now()) @map("updated_at")
  rolePermissions      RolePermission[]
  userPermissions      UserPermission[]

  @@index([category])
  @@index([name])
  @@index([scope])
  @@map("permissions")
}

model PlanFeature {
  featureCategoryId Int       @id @default(autoincrement())
  title             String    @map("title")
  features          Json      @map("features")
  displayOrder      Int?      @default(0) @map("display_order")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")
  
  @@map("plan_features")
}

model RolePermission {
  id                Int         @id @default(autoincrement())
  rolePermissionId  String      @unique @map("role_permission_id")
  roleId            String      @map("role_id")
  permissionId      String      @map("permission_id")
  synced            Int?        @default(0) @map("synced")
  createdAt         DateTime?   @default(now()) @map("created_at")
  updatedAt         DateTime?   @default(now()) @map("updated_at")
  role              Role        @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: NoAction)
  permission        Permission  @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, permissionId], name: "unique_role_permission")
  @@index([permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model Role {
  id               Int                @id @default(autoincrement())
  roleId           String             @unique @map("role_id")
  name             String             @unique @map("name")
  displayName      String             @map("display_name")
  description      String?            @map("description")
  synced           Int?               @default(0) @map("synced")
  isSystemRole     Boolean?           @default(false) @map("is_system_role")
  isActive         Boolean?           @default(true) @map("is_active")
  createdAt        DateTime?          @default(now()) @map("created_at")
  updatedAt        DateTime?          @default(now()) @map("updated_at")
  rolePermissions  RolePermission[]
  users            User[]

  @@index([isActive], name: "idx_active_role")
  @@index([name], name: "idx_role_name")
  @@index([isSystemRole], name: "idx_system_role")
  @@map("roles")
}

model ServiceProvider {
  id          Int       @id @default(autoincrement())
  providerId  String    @unique @map("provider_id")
  branchId    String    @map("branch_id")
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  name        String    @map("name")
  description String?   @map("description")
  logoUrl     String?   @map("logoUrl")
  isActive    Boolean?  @default(true) @map("is_active")
  sortOrder   Int?      @default(0) @map("sort_order")
  synced      Int?      @default(0) @map("synced")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")
  branch      Branch    @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branchId, name], name: "unique_branch_service_provider")
  @@index([branchId])
  @@map("service_provider")
}

model SubscriptionPlan {
  subscriptionPlanId String                 @id @default(uuid()) @map("subscription_plan_id")
  planCode           String                 @unique @map("plan_code")
  name               String                 @map("name")
  description        String?                @map("description")
  monthlyPrice       Decimal                @default(0.00) @map("monthly_price")
  yearlyPrice        Decimal                @default(0.00) @map("yearly_price")
  color              String                 @default("gray") @map("color")
  isPopular          Boolean?               @default(false) @map("is_popular")
  isActive           Boolean?               @default(true) @map("is_active")
  features           Json                   @map("features")
  limits             Json                   @map("limits")
  notes              String?                @map("notes")
  synced             Int?                   @default(0) @map("synced")
  createdAt          DateTime?              @default(now()) @map("created_at")
  updatedAt          DateTime?              @default(now()) @map("updated_at")
  tenantSubscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  tenantSubscriptionId String                 @id @default(uuid()) @map("tenant_subscription_id")
  tenantId             String                 @map("tenant_id")
  subscriptionPlanId   String                 @map("subscription_plan_id")
  status               TenantSubscriptionStatus? @default(active) @map("status")
  startsAt             DateTime               @map("starts_at")
  endsAt               DateTime?              @map("ends_at")
  autoRenew            Boolean?               @default(true) @map("auto_renew")
  paymentMethod        String?                @map("payment_method")
  maxBranches          Int?                   @default(1) @map("max_branches")
  synced               Int?                   @default(0) @map("synced")
  lastPaymentDate      DateTime?              @map("last_payment_date")
  nextPaymentDate      DateTime?              @map("next_payment_date")
  createdAt            DateTime?              @default(now()) @map("created_at")
  updatedAt            DateTime?              @default(now()) @map("updated_at")
  tenant               Tenant                 @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)
  subscriptionPlan     SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [subscriptionPlanId], onUpdate: NoAction)

  @@index([subscriptionPlanId])
  @@index([tenantId])
  @@map("tenant_subscriptions")
}

model Tenant {
  id                    Int                            @id @default(autoincrement())
  tenantId              String                         @unique @map("tenant_id")
  businessName          String                         @map("business_name")
  tin                   String                         @unique @map("tin")
  tenantCode            String                         @unique @map("tenant_code")
  businessType          TenantBusinessType             @map("business_type")
  phoneNumber           String                         @map("phone_number")
  email                 String                         @unique @map("email")
  mraPortalUsername     String?                        @map("mra_portal_username")
  tradingName           String?                        @map("trading_name")
  isVatRegistered       Boolean?                       @default(false) @map("is_vat_registered")
  taxOfficeCode         String?                        @map("tax_office_code")
  msonkhoOnlineStatus   TenantMsonkhoOnlineStatus?     @default(PENDING) @map("msonkho_online_status")
  subscriptionPlan      String?                        @map("subscription_plan")
  subscriptionStatus    TenantSubscriptionPlanStatus?  @default(TRIAL) @map("subscription_status")
  ownerName             String                         @map("owner_name")
  address               String?                        @map("address")
  country               String?                        @map("country")
  verificationToken     String                        @map("verification_token")
  trialEndsAt           DateTime?                      @map("trial_ends_at")
  status                TenantStatus?                  @default(pending) @map("status")
  registeredAt          DateTime?                      @default(now()) @map("registered_at")
  activatedAt           DateTime?                      @map("activated_at")
  synced                Int?                           @default(0) @map("synced")
  createdAt             DateTime?                      @default(now()) @map("created_at")
  updatedAt             DateTime?                      @default(now()) @map("updated_at")
  mraApiConfigTable     MRA_API_CONFIG_TABLE[]
  auditLogs             AuditLog[]
  branches              Branch[]
  paymentMethods        PaymentMethod[]
  tenantSubscriptions   TenantSubscription[]
  terminals             Terminal[]
  users                 User[]

  @@index([email])
  @@index([subscriptionStatus])
  @@index([tenantCode])
  @@index([tin])
  @@map("tenants")
}

model Terminal {
  id                                Int                               @id @default(autoincrement())
  terminalId                        String                            @unique @map("terminal_id")
  tenantId                          String                            @map("tenant_id")
  branchId                          String                            @map("branch_id")
  mraTerminalId                     String?                           @unique @map("mra_terminal_id")
  terminalCode                      String                            @unique @map("terminal_code")
  terminalLabel                     String                            @map("terminal_label")
  terminalPosition                  Int?                              @map("terminal_position")
  deviceId                          String?                           @map("device_id")
  osName                            String?                           @map("os_name")
  osVersion                         String?                           @map("os_version")
  osBuild                           String?                           @map("os_build")
  macAddress                        String?                           @map("mac_address")
  posProductId                      String?                           @map("pos_product_id")
  posProductVersion                 String?                           @map("pos_product_version")
  terminalConfigVersion             Decimal?                          @map("terminal_config_version")
  offlineMaxTransactionAgeHours     Decimal?                          @map("offline_max_transaction_age_hours")
  offlineMaxCumulativeAmount        Decimal?                          @map("offline_max_cumulative_amount")
  activationCode                    String?                           @map("activation_code")
  activationStatus                  TerminalActivationStatus?         @default(PENDING) @map("activation_status")
  activationDate                    DateTime?                         @map("activation_date")
  isPrimary                         Boolean?                          @default(false) @map("is_primary")
  isBlocked                         Boolean?                          @default(false) @map("is_blocked")
  blockingReason                    String?                           @map("blocking_reason")
  blockedAt                         DateTime?                         @map("blocked_at")
  mraApplicationStatus              TerminalMRAApplicationStatus?     @default(APPLIED) @map("mra_application_status")
  mraApprovalDate                   DateTime?                         @map("mra_approval_date")
  lastActivity                      DateTime?                         @map("last_activity")
  lastSync                          DateTime?                         @map("last_sync")
  lastSyncTimestamp                 DateTime?                         @map("last_sync_timestamp")
  synced                            Int?                              @default(0) @map("synced")
  registeredAt                      DateTime?                         @map("registered_at")
  createdAt                         DateTime?                         @default(now()) @map("created_at")
  updatedAt                         DateTime?                         @default(now()) @map("updated_at")
  auditLogs                         AuditLog[]
  categories                        Category[]
  tenant                            Tenant                            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)
  branch                            Branch                            @relation(fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)
  userSessions                      UserSession[]

  @@index([activationStatus])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId])
  @@map("terminals")
}

model Transaction {
  id                          Int       @id @default(autoincrement())
  transactionId              String    @unique @map("transaction_id")
  refNumber                  String    @map("ref_number")
  discount                   Decimal?  @default(0.00) @map("discount")
  customerId                 String?   @map("customer_id")
  subtotal                   Decimal?  @default(0.00) @map("subtotal")
  tax                        Decimal?  @default(0.00) @map("tax")
  date                       DateTime? @map("date")
  paymentMethodId           String?   @map("payment_method_id")
  phoneNumber               String?   @map("phone_number")
  paymentServiceProviderId  String?   @map("payment_service_provider_id")
  total                      Decimal?  @default(0.00) @map("total")
  paid                       Decimal?  @default(0.00) @map("paid")
  changeAmount               Decimal?  @default(0.00) @map("change_amount")
  terminalId                String?   @map("terminal_id")
  userId                    String?   @map("user_id")
  tenantId                  String    @map("tenant_id")
  branchId                  String    @map("branch_id")

  synced                   Int?      @default(0) @map("synced")
  createdAt                DateTime? @default(now()) @map("created_at")
  updatedAt                DateTime? @default(now()) @map("updated_at")

  // ADDED: Link to Sale model
  saleId String? @map("sale_id")

  branch                 Branch                  @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  customer               Customer?               @relation(fields: [customerId], references: [customerId], onDelete: SetNull, map: "fk_transactions_customer")

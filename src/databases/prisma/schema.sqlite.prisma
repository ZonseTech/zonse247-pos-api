model User {
  id                                                  Int                @id @default(autoincrement())
  userId                                              String             @unique @map("user_id")
  tenantId                                            String             @map("tenant_id")
  branchId                                            String             @map("branch_id")
  username                                            String             @map("username")
  password                                            String             @map("password")
  fullname                                            String             @map("fullname")
  email                                               String?            @map("email")
  phone                                               String?            @map("phone")
  roleId                                              String             @map("role_id")
  status                                              UserStatus?        @default(active) @map("status")
  accessibleBranches                                  Json?              @map("accessible_branches")
  allowedTerminals                                    Json?              @map("allowed_terminals")
  maxDiscountPercent                                  Decimal?           @default(0.00) @map("max_discount_percent")
  canOverridePrices                                   Boolean?           @default(false) @map("can_override_prices")
  pinCode                                             String?            @map("pin_code")
  currentBranchId                                     String?            @map("current_branch_id")
  lastLogin                                           DateTime?          @map("last_login")
  lastLogout                                          DateTime?          @map("last_logout")
  passwordChangedAt                                   DateTime?          @default(now()) @map("password_changed_at")
  forcePasswordChange                                 Boolean?           @default(false) @map("force_password_change")
  synced                                              Int?               @default(0) @map("synced")
  createdAt                                           DateTime?          @default(now()) @map("created_at")
  updatedAt                                           DateTime?          @default(now()) @map("updated_at")
  auditLogs                                           AuditLog[]
  inventoryCreatedBy                                  Inventory[]        @relation("inventory_created_byTousers")
  inventoryLastUpdatedBy                              Inventory[]        @relation("inventory_last_updated_byTousers")
  paymentMethods                                      PaymentMethod[]
  userPermissionsUser                                 UserPermission[]   @relation("user_permissions_user_idTousers")
  userPermissionsCreatedBy                            UserPermission[]   @relation("user_permissions_created_byTousers")
  userSessions                                        UserSession[]
  tenant                                              Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, onUpdate: NoAction)
  branch                                              Branch             @relation("users_branch_idTobranches", fields: [branchId], references: [branchId], onDelete: Cascade, onUpdate: NoAction)
  role                                                Role               @relation(fields: [roleId], references: [roleId], onUpdate: NoAction)
  currentBranch                                       Branch?            @relation("users_current_branch_idTobranches", fields: [currentBranchId], references: [branchId], onUpdate: NoAction)

  @@unique([tenantId, username], name: "unique_tenant_username")
  @@index([branchId])
  @@index([currentBranchId])
  @@index([roleId])
  @@index([tenantId])
  @@index([username])
  @@map("users")
}


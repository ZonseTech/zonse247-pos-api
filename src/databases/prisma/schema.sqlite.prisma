generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
}

model Product {
  id         String  @id @default(cuid()) @map("product_id")
  tenantId   String  @map("tenant_id")
  branchId   String  @map("branch_id")
  categoryId String? @map("category_id")
  name       String  @map("name")
  description String? @map("description")

  // Brand info
  brand      String? @map("brand")

  // Tax (applies to all variants unless overridden)
  isTaxable  Boolean? @map("is_taxable")

  // Supplier info (common supplier for all variants)
  supplierName String? @map("supplier_name")
  supplierCode String? @map("supplier_code")

  // Default unit for variants (can be overridden per variant)
  defaultUnit String? @map("default_unit")

  // Custom attributes schema (defines what custom fields variants can have)
  customAttributeSchema String? @map("custom_attribute_schema")

  // Image for the product (main product image)
  imageUrl   String? @map("image_url")

  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)

  variants ProductVariant[] // All variants of this product

  @@unique([branchId, name], name: "unique_branch_product_name")
  @@index([branchId])
  @@index([tenantId])
  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// ProductVariant is the sellable unit (e.g., "Nivea 50ml", "Nivea 200ml")
model ProductVariant {
  id         String  @id @default(cuid()) @map("variant_id")
  productId  String  @map("product_id")
  tenantId   String  @map("tenant_id")
  branchId   String  @map("branch_id")

  // Variant identification
  sku         String? @map("sku")
  variantName String  @map("variant_name")

  // Primary barcode for this variant
  primaryBarcode String? @unique @map("primary_barcode")

  // Pricing
  sellingPrice Float   @default(0.00) @map("selling_price")
  costPrice    Float   @default(0.00) @map("cost_price")

  // Unit for this variant
  unit        String  @default("piece") @map("unit")

  // Optional variant-level overrides (inherit from Product if null)
  description  String?  @map("description")
  brand        String?  @map("brand")
  imageUrl     String?  @map("image_url")
  isTaxable    Boolean? @map("is_taxable")
  supplierName String?  @map("supplier_name")
  supplierCode String?  @map("supplier_code")

  // Size/weight/volume attributes
  size        String? @map("size")
  weight      Float?  @map("weight")
  weightUnit  String? @map("weight_unit")
  volume      Float?  @map("volume")
  volumeUnit  String? @map("volume_unit")
  dimensions  String? @map("dimensions")

  // Additional variant attributes (JSON)
  customAttributes String? @map("custom_attributes")

  // Promotional pricing
  promoPrice  Float?    @map("promo_price")
  promoStart  DateTime? @map("promo_start")
  promoEnd    DateTime? @map("promo_end")

  // Dates
  expirationDate  DateTime? @map("expiration_date")
  manufactureDate DateTime? @map("manufacture_date")

  // Expiry date alert - days before expiration to trigger alert (e.g., 30 days)
  expiryDateAlert Int?     @map("expiry_date_alert")

  // Is this the default variant?
  isDefault   Boolean @default(false) @map("is_default")

  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch  @relation(fields: [branchId], references: [branchId], onDelete: Cascade)

  inventory   Inventory?
  purchaseOrderItems PurchaseOrderItem[]
  saleItems   SaleItem[]
  barcodes    VariantBarcode[]

  @@unique([productId, variantName], name: "unique_product_variant")
  @@index([productId])
  @@index([branchId])
  @@index([tenantId])
  @@index([sku])
  @@index([primaryBarcode])
  @@index([variantName])
  @@map("product_variants")
}

// VariantBarcode - multiple barcodes per variant
model VariantBarcode {
  id          String      @id @default(cuid()) @map("variant_barcode_id")
  variantId   String      @map("variant_id")
  barcode     String      @unique @map("barcode")
  barcodeType BarcodeType @default(EAN13) @map("barcode_type")

  barcodeSource BarcodeSource @default(SUPPLIER) @map("barcode_source")
  description   String?       @map("description")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, barcode], name: "unique_variant_barcode")
  @@index([variantId])
  @@index([barcode])
  @@map("variant_barcodes")
}

// DEPRECATED: Keep for backward compatibility
model ProductBarcode {
  id          String      @id @default(cuid()) @map("product_barcode_id")
  productId   String      @map("product_id")
  barcode     String      @unique @map("barcode")
  barcodeType BarcodeType @default(EAN13) @map("barcode_type")

  // ADDED: Barcode source/type classification
  barcodeSource BarcodeSource @default(SUPPLIER) @map("barcode_source")
  description   String?       @map("description")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, barcode], name: "unique_product_barcode")
  @@index([productId])
  @@index([barcode])
  @@map("product_barcodes")
}

// ADD ENUM for barcode types
enum BarcodeType {
  EAN13 // 13-digit European Article Number
  EAN8 // 8-digit European Article Number
  UPCA // 12-digit Universal Product Code
  UPCE // 6-digit UPC
  CODE39 // Variable length alphanumeric
  CODE128 // Variable length high-density
  QR // QR Code
  CUSTOM // Custom barcode format
}

// ADD NEW ENUM for barcode sources
enum BarcodeSource {
  MANUFACTURER // Original manufacturer barcode
  SUPPLIER // Supplier/distributor barcode
  STORE // Your store's internal barcode
  BUNDLE // Barcode for product bundle
  PACKAGING // Different packaging barcode (6-pack, case, etc.)
  CUSTOM // Custom/alternate barcode
}

model Supplier {
  id            String         @id @default(cuid()) @map("supplier_id")
  tenantId      String         @map("tenant_id")
  branchId      String         @map("branch_id")
  name          String         @map("name")
  contactPerson String?        @map("contact_person")
  email         String?        @map("email")
  phone         String?        @map("phone")
  address       String?        @map("address")
  taxId         String?        @map("tax_id")
  paymentTerms  PaymentTerms   @default(CASH_ON_DELIVERY) @map("payment_terms")
  creditLimit   Float          @default(0) @map("credit_limit")
  status        SupplierStatus @default(ACTIVE) @map("status")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([branchId])
  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id                   String              @id @default(cuid()) @map("purchase_order_id")
  tenantId             String              @map("tenant_id")
  branchId             String              @map("branch_id")
  supplierId           String              @map("supplier_id")
  poNumber             String              @unique @map("po_number")
  status               PurchaseOrderStatus @default(PENDING) @map("status")
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  receivedAt           DateTime?           @map("received_at")
  notes                String?             @map("notes")
  createdBy            String              @map("created_by")
  receivedBy           String?             @map("received_by")
  isLocked             Boolean             @default(false) @map("is_locked")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseOrderItem[]
  createdByUser  User                @relation("purchase_orders_created_by", fields: [createdBy], references: [userId], onDelete: Restrict)
  receivedByUser User?               @relation("purchase_orders_received_by", fields: [receivedBy], references: [userId], onDelete: SetNull)

  @@index([branchId])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@index([poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid()) @map("purchase_order_item_id")
  purchaseOrderId  String   @map("purchase_order_id")
  variantId        String   @map("variant_id")
  orderedQuantity  Int      @default(0) @map("ordered_quantity")
  receivedQuantity Int      @default(0) @map("received_quantity")
  damagedQuantity  Int      @default(0) @map("damaged_quantity")
  unitPrice        Float    @default(0.00) @map("unit_price")
  totalPrice       Float    @default(0.00) @map("total_price")
  notes            String?  @map("notes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, variantId], name: "unique_po_variant")
  @@index([purchaseOrderId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model Inventory {
  id        String @id @default(cuid()) @map("inventory_id")
  tenantId  String @map("tenant_id")
  branchId  String @map("branch_id")
  productId String @map("product_id")
  variantId String? @unique @map("variant_id")

  availableQuantity Int @default(0) @map("available_quantity")
  reservedQuantity  Int @default(0) @map("reserved_quantity")
  damagedQuantity   Int @default(0) @map("damaged_quantity")

  averageCost      Float @default(0.00) @map("average_cost")
  lastPurchaseCost Float @default(0.00) @map("last_purchase_cost")

  reorderPoint       Int?    @map("reorder_point")
  maxStock           Int?    @map("max_stock")
  trackInventory     Boolean @default(true) @map("track_inventory")
  allowNegativeStock Boolean @default(false) @map("allow_negative_stock")

  lastRestockedAt DateTime? @map("last_restocked_at")
  lastSoldAt      DateTime? @map("last_sold_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([branchId])
  @@index([tenantId])
  @@index([variantId])
  @@index([productId])
  @@map("inventory")
}

model StockMovement {
  id          String @id @default(cuid()) @map("stock_movement_id")
  tenantId    String @map("tenant_id")
  branchId    String @map("branch_id")
  inventoryId String @map("inventory_id")

  movementType     StockMovementType @map("movement_type")
  quantity         Int               @map("quantity")
  previousQuantity Int               @map("previous_quantity")
  newQuantity      Int               @map("new_quantity")

  referenceType StockReferenceType? @map("reference_type")
  referenceId   String?             @map("reference_id")

  unitCost  Float @default(0.00) @map("unit_cost")
  totalCost Float @default(0.00) @map("total_cost")

  notes        String?  @map("notes")
  movedBy      String   @map("moved_by")
  movementDate DateTime @default(now()) @map("movement_date")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  movedByUser User      @relation(fields: [movedBy], references: [userId], onDelete: Restrict)

  @@index([branchId])
  @@index([tenantId])
  @@index([inventoryId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([movementDate])
  @@map("stock_movements")
}

model Sale {
  id         String @id @default(cuid()) @map("sale_id")
  tenantId   String @map("tenant_id")
  branchId   String @map("branch_id")
  saleNumber String @map("sale_number")

  customerId String? @map("customer_id")
  terminalId String? @map("terminal_id")
  userId     String  @map("user_id")

  subtotal       Float @default(0.00) @map("subtotal")
  taxAmount      Float @default(0.00) @map("tax_amount")
  discountAmount Float @default(0.00) @map("discount_amount")
  otherCharges   Float @default(0.00) @map("other_charges")
  totalAmount    Float @default(0.00) @map("total_amount")

  amountPaid      Float   @default(0.00) @map("amount_paid")
  changeAmount    Float   @default(0.00) @map("change_amount")
  paymentMethodId String? @map("payment_method_id")

  status   SaleStatus @default(COMPLETED) @map("status")
  saleDate DateTime   @default(now()) @map("sale_date")
  notes    String?    @map("notes")

  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [branchId], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [customerId], onDelete: SetNull, map: "fk_sales_customer")
  terminal      Terminal?      @relation(fields: [terminalId], references: [terminalId], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [userId], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [methodId], onDelete: SetNull)
  items         SaleItem[]
  voidedByUser  User?          @relation("sales_voided_by", fields: [voidedBy], references: [userId], onDelete: SetNull)
  transactions  Transaction[]
  payments      SalePayment[]  // NEW: Support for multiple payment methods

  @@unique([tenantId, branchId, saleNumber], name: "unique_tenant_branch_sale_number")
  @@index([branchId])
  @@index([tenantId])
  @@index([customerId])
  @@index([terminalId])
  @@index([userId])
  @@index([saleDate])
  @@index([saleNumber])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(cuid()) @map("sale_item_id")
  saleId    String @map("sale_id")
  productId String @map("product_id")  // Legacy field - parent product ID
  variantId String @map("variant_id")

  quantity  Int   @map("quantity")
  unitPrice Float @map("unit_price")
  unitCost  Float @default(0.00) @map("unit_cost")

  subtotal       Float @map("subtotal")
  taxAmount      Float @default(0.00) @map("tax_amount")
  discountAmount Float @default(0.00) @map("discount_amount")
  totalAmount    Float @map("total_amount")

  createdAt DateTime @default(now()) @map("created_at")

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([saleId, variantId], name: "unique_sale_variant")
  @@index([saleId])
  @@index([variantId])
  @@index([productId])
  @@map("sale_items")
}

// ==========================================
// MULTIPLE PAYMENT SUPPORT (Split Payments)
// ==========================================
// Allows a single sale to have multiple payment methods
// e.g., K5,000 cash + K3,000 card for a K8,000 total
// Backward compatible: existing sales with single paymentMethodId continue to work

model SalePayment {
  id              String        @id @default(uuid()) @map("sale_payment_id")
  saleId          String        @map("sale_id")
  paymentMethodId String        @map("payment_method_id")
  
  amount          Float         @map("amount")
  reference       String?       @map("reference")         // Card ref, mobile money transaction ID, etc.
  
  // Payment provider info (for mobile money, card payments, etc.)
  providerId      String?       @map("provider_id")       // Links to payment service provider
  providerRef     String?       @map("provider_ref")      // External reference from provider
  
  status          PaymentStatus @default(COMPLETED) @map("status")
  processedAt     DateTime      @default(now()) @map("processed_at")
  
  notes           String?       @map("notes")
  synced          Int           @default(0) @map("synced")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [methodId], onDelete: Restrict)
  
  @@index([saleId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([processedAt])
  @@map("sale_payments")
}

// ==========================================
// ORIGINAL MODELS
// ==========================================

model MRA_API_CONFIG_TABLE {
  configId          String                            @id @default(cuid()) @map("config_id")
  tenantId          String                            @map("tenant_id")
  environment       MRA_API_CONFIG_TABLE_environment? @default(SANDBOX) @map("environment")
  apiBaseUrl        String                            @map("api_base_url")
  apiKey            String?                           @map("api_key")
  apiSecret         String?                           @map("api_secret")
  lastSyncTimestamp DateTime?                         @map("last_sync_timestamp")
  syncStatus        MRA_API_CONFIG_TABLE_sync_status? @default(SUCCESS) @map("sync_status")
  isActive          Boolean?                          @default(true) @map("is_active")
  createdAt         DateTime?                         @default(now()) @map("created_at")
  updatedAt         DateTime?                         @default(now()) @map("updated_at")
  tenant            Tenant                            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, environment], name: "unique_tenant_env")
  @@map("mra_api_config_table")
}

model AuditLog {
  id             Int                @id @default(autoincrement())
  logId          String             @unique @map("log_id")
  tenantId       String?            @map("tenant_id")
  branchId       String?            @map("branch_id")
  userId         String?            @map("user_id")
  terminalId     String?            @map("terminal_id")
  actionType     AuditLogActionType @map("action_type")
  entityType     String             @map("entity_type")
  entityId       String?            @map("entity_id")
  entityName     String?            @map("entity_name")
  oldValues      Json?              @map("old_values")
  newValues      Json?              @map("new_values")
  changesSummary String?            @map("changes_summary")
  ipAddress      String?            @map("ip_address")
  userAgent      String?            @map("user_agent")
  requestMethod  String?            @map("request_method")
  requestUrl     String?            @map("request_url")
  description    String?            @map("description")
  synced         Int?               @default(0) @map("synced")
  severity       AuditLogSeverity?  @default(low) @map("severity")
  createdAt      DateTime?          @default(now()) @map("created_at")
  tenant         Tenant?            @relation(fields: [tenantId], references: [tenantId])
  branch         Branch?            @relation(fields: [branchId], references: [branchId])
  user           User?              @relation(fields: [userId], references: [userId])
  terminal       Terminal?          @relation(fields: [terminalId], references: [terminalId])

  @@index([actionType])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([tenantId])
  @@index([terminalId])
  @@index([userId])
  @@map("audit_logs")
}

// District model for Malawi districts
model District {
  id          Int       @id @default(autoincrement())
  districtId  String    @unique @map("district_id")
  name        String    @map("name")
  region      String    @map("region") // Northern, Central, Southern
  code        String    @unique @map("code") // District code (e.g., DOW for Dowa)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  branches    Branch[]
  
  @@index([region])
  @@index([isActive])
  @@map("districts")
}

model BranchSetting {
  id              Int                  @id @default(autoincrement())
  branchSettingId String               @unique @map("branch_setting_id")
  tenantId        String               @map("tenant_id")
  branchId        String               @unique @map("branch_id")
  terminalId      String               @map("terminal_id")
  app             String?              @map("app")
  store           String?              @map("store")
  addressLine1    String?              @map("address_line1")
  addressLine2    String?              @map("address_line2")
  country         String?              @map("country")
  city            String?              @map("city")
  contact         String?              @map("contact")
  tax             String?              @map("tax")
  symbol          String?              @map("symbol")
  footer          String?              @map("footer")
  status          BranchSettingStatus? @default(inactive) @map("status")
  synced          Int?                 @default(0) @map("synced")
  createdAt       DateTime?            @default(now()) @map("created_at")
  updatedAt       DateTime?            @default(now()) @map("updated_at")
  branch          Branch               @relation(fields: [branchId], references: [branchId], onDelete: Cascade)

  @@index([branchId])
  @@map("branch_settings")
}

model Branch {
  id                 Int                      @id @default(autoincrement())
  branchId           String                   @unique @map("branch_id")
  tenantId           String                   @map("tenant_id")
  branchName         String                   @map("branch_name")
  branchCode         String                   @map("branch_code")
  siteId             String?                  @map("site_id")
  siteName           String?                  @map("site_name")
  description        String?                  @map("description")
  addressLine1       String?                  @map("address_line_1")
  addressLine2       String?                  @map("address_line_2")
  addressLine3       String?                  @map("address_line_3")
  districtId         String?                  @map("district_id")
  location           String?                  @map("location")
  businessType       BusinessType?            @default(PRODUCT_BASED) @map("business_type")
  city               String?                  @map("city")
  state              String?                  @map("state")
  postalCode         String?                  @map("postal_code")
  phoneNumber        String?                  @map("phone_number")
  email              String?                  @map("email")
  currencyCode       String?                  @default("MKW") @map("currency_code")
  currencySymbol     String?                  @default("K") @map("currency_symbol")
  taxRate            Float?                   @default(0.00) @map("tax_rate")
  chargeTax          Boolean?                 @default(false) @map("charge_tax")
  receiptFooter      String?                  @map("receipt_footer")
  logoUrl            String?                  @map("logo_url")
  isVirtualWarehouse Boolean?                 @default(false) @map("is_virtual_warehouse")
  isActive           Boolean?                 @default(true) @map("is_active")
  synced             Int?                     @default(0) @map("synced")
  mraApprovalStatus  BranchMRAApprovalStatus? @default(PENDING) @map("mra_approval_status")
  mraApprovalDate    DateTime?                @map("mra_approval_date")
  status             BranchStatus?            @default(active) @map("status")
  createdAt          DateTime?                @default(now()) @map("created_at")
  updatedAt          DateTime?                @default(now()) @map("updated_at")

  auditLogs          AuditLog[]
  branchSetting      BranchSetting?
  tenant             Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

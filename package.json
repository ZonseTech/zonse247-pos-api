{
  "name": "zonse247-pos-api",
  "version": "1.9.0",
  "description": "Zonse247 POS API - A point of sale API system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "prisma": {
    "schema": "src/databases/prisma/schema.prisma",
    "seed": "tsx src/databases/prisma/seed.ts"
  },
  "scripts": {
    "task": "task",
    "task:list": "task --list-all",
    "build": "bash scripts/db.sh generate mysql && tsc",
    "build:sqlite": "bash scripts/db.sh generate sqlite && npm run clean && tsc",
    "build:mysql": "bash scripts/db.sh generate mysql && npm run clean && tsc",
    "build:clean": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "build:package": "bash scripts/db.sh generate sqlite && npm run clean && tsc && npm run db:build-template && npm run db:copy-template",
    "start": "node dist/main.js",
    "dev": "nodemon --exec ts-node src/main.ts",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.js --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:ci": "jest --ci --passWithNoTests",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "version:patch": "npm version patch && git push --follow-tags",
    "version:minor": "npm version minor && git push --follow-tags",
    "version:major": "npm version major && git push --follow-tags",
    "preview:build": "npm run build:package && npm pack",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop api",
    "pm2:restart": "pm2 restart api",
    "pm2:logs": "pm2 logs api",
    "pm2:monitor": "pm2 monit",
    "pm2:status": "pm2 status",
    "deploy:setup": "chmod +x server-setup.sh && ./server-setup.sh",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "pub:dry-run": "npm run build:package && npm pack",
    "pub:local": "npm run build:package && npm pack",
    "pub:npm": "npm run build:package && npm publish",
    "pub:npm:public": "npm run build:package && npm publish --access public",
    "pub:npm:otp": "npm run build:package && npm publish --otp",
    "db": "bash scripts/db.sh",
    "db:switch:sqlite": "bash scripts/db.sh generate sqlite",
    "db:switch:mysql": "bash scripts/db.sh generate mysql",
    "db:generate:sqlite": "bash scripts/db.sh generate sqlite",
    "db:generate:mysql": "bash scripts/db.sh generate mysql",
    "db:generate:all": "bash scripts/db.sh generate sqlite && bash scripts/db.sh generate mysql",
    "db:migrate:sqlite": "bash scripts/db.sh migrate sqlite",
    "db:migrate:mysql": "bash scripts/db.sh migrate mysql",
    "db:push:sqlite": "bash scripts/db.sh push sqlite",
    "db:push:mysql": "bash scripts/db.sh push mysql",
    "db:studio:sqlite": "bash scripts/db.sh studio sqlite",
    "db:studio:mysql": "bash scripts/db.sh studio mysql",
    "db:status:sqlite": "bash scripts/db.sh status sqlite",
    "db:status:mysql": "bash scripts/db.sh status mysql",
    "db:reset:sqlite": "bash scripts/db.sh reset sqlite",
    "db:reset:mysql": "bash scripts/db.sh reset mysql",
    "db:seed": "prisma db seed",
    "seed:permissions": "tsx scripts/seed-role-permissions.ts",
    "backfill:payment-methods": "tsx scripts/backfill-payment-methods.ts",
    "db:pull": "prisma db pull",
    "db:freeze:sqlite": "bash scripts/db.sh generate sqlite && echo '✓ Schema and client frozen for SQLite'",
    "db:freeze:mysql": "bash scripts/db.sh generate mysql && echo '✓ Schema and client frozen for MySQL'",
    "db:build-template": "cross-env DATABASE_URL=file:./src/databases/prisma/template.db npx prisma db push --accept-data-loss && npm run db:stamp-version && echo '✓ Template database created with version'",
    "db:stamp-version": "node -e \"const Database = require('better-sqlite3'); const db = new Database('./src/databases/prisma/template.db'); db.exec('CREATE TABLE IF NOT EXISTS db_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT DEFAULT CURRENT_TIMESTAMP)'); db.exec(\\\"INSERT OR REPLACE INTO db_meta (key, value, updated_at) VALUES ('schema_version', '20260108_01', datetime('now')), ('created_at', datetime('now'), datetime('now'))\\\"); db.close(); console.log('✓ Version stamped');\"",
    "db:copy-template": "mkdir -p dist/databases && cp src/databases/prisma/template.db dist/databases/template.db && echo '✓ Template database copied to dist'"
  },
  "keywords": [
    "pos",
    "api",
    "point-of-sale",
    "rest-api",
    "typescript",
    "nodejs",
    "express"
  ],
  "author": "McLean Kasambala",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZonseTech/zonse247-pos-api.git"
  },
  "homepage": "https://github.com/ZonseTech/zonse247-pos-api#readme",
  "bugs": {
    "url": "https://github.com/ZonseTech/zonse247-pos-api/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "async": "^3.2.6",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.6.0",
    "body-parser": "^2.2.0",
    "bonjour-service": "^1.3.0",
    "chalk": "^5.4.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "papaparse": "^5.5.3",
    "ping": "^0.4.4",
    "qs": "^6.15.1",
    "sanitize-filename": "^1.6.3",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "typescript-nedb-orm": "^1.7.0",
    "usb": "^2.16.0",
    "uuid": "^11.1.0",
    "validator": "^13.15.0"
  },
  "devDependencies": {
    "@go-task/cli": "^3.49.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/async": "^3.2.24",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bonjour": "^3.5.13",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.16",
    "@types/qs": "^6.15.0",
    "@types/validator": "^13.12.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "7.8.0",
    "rollup": "^4.53.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.24.0"
  },
  "optionalDependencies": {
    "bluetooth-serial-port": "^3.0.2"
  },
  "peerDependencies": {
    "axios": "^1.8.4"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": false
    }
  }
}

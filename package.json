{
  "name": "zonse247-pos-api",
  "version": "1.4.0",
  "description": "Zonse247 POS API - A point of sale API system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "task": "task",
    "task:list": "task --list-all",
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "build:watch": "tsc --watch",
    "prepack": "npm run build:clean && npm run test:ci",
    "start": "node dist/main.js",
    "dev": "nodemon --exec ts-node src/main.ts",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.js --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:ci": "jest --ci --passWithNoTests",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "version:patch": "npm version patch && git push --follow-tags",
    "version:minor": "npm version minor && git push --follow-tags",
    "version:major": "npm version major && git push --follow-tags",
    "preview:build": "npm run build:clean && npm pack",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop api",
    "pm2:restart": "pm2 restart api",
    "pm2:logs": "pm2 logs api",
    "pm2:monitor": "pm2 monit",
    "pm2:status": "pm2 status",
    "deploy:setup": "chmod +x server-setup.sh && ./server-setup.sh",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "pub:dry-run": "npm run build:clean && npm pack",
    "pub:local": "npm run build:clean && npm pack",
    "pub:npm": "npm run build:clean && npm publish",
    "pub:npm:public": "npm run build:clean && npm publish --access public",
    "pub:npm:otp": "npm run build:clean && npm publish --otp",
    "db:seed": "prisma db seed",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "pos",
    "api",
    "point-of-sale",
    "rest-api",
    "typescript",
    "nodejs",
    "express"
  ],
  "author": "McLean Kasambala",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZonseTech/zonse247-pos-api.git"
  },
  "homepage": "https://github.com/ZonseTech/zonse247-pos-api#readme",
  "bugs": {
    "url": "https://github.com/ZonseTech/zonse247-pos-api/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.12.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "path": "^0.12.7",
    "prisma": "^7.0.1",
    "ts-jest": "^29.4.5"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.0.1",
    "@prisma/adapter-mariadb": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "async": "^3.2.6",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "chalk": "^5.4.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http": "^0.0.1-security",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "papaparse": "^5.5.3",
    "sanitize-filename": "^1.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.24.0",
    "typescript-nedb-orm": "^1.7.0",
    "uuid": "^11.1.0",
    "validator": "^13.15.0"
  },
  "peerDependencies": {
    "axios": "^1.8.4"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": false
    }
  }
}

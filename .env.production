NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database configuration
DB_HOST=api-server-db-host
DB_USER=api-server-db-user
DB_PASSWORD=api-server-db-password
DB_NAME=api-server-db-name

# JWT Configuration
JWT_SECRET=api-server-jwt-secret

# File Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./.backups/uploads
MIGRATIONS_PATH=./.backups/migrations
APP_DATA_PATH=./.data/zonse247-pos

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

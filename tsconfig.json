{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "src/types"]
  },
  "include": [
    "*.ts",
    "*.js",
    "*.json",
    "src/types/**/*.d.ts",
    "src/server.ts",
    "src/index.ts"
  ],
  "ts-node": {
    "files": true
  }
}

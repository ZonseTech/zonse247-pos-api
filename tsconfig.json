{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"declaration": true,
		"typeRoots": ["./node_modules/@types", "./src/types"],
		"baseUrl": "./",
		"paths": {
			"@/*": ["src/*"],
			"@/types/*": ["src/types/*"]
		}
	},
	"include": ["src/**/*", "src/types/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
